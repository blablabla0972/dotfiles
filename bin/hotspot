#!/usr/bin/env bash
# ==============================================================================
# Mobile Hotspot Manager for CachyOS / Arch Linux
# ==============================================================================

set -euo pipefail

# Force C locale to prevent unicode matching issues and stabilize nmcli output
export LC_ALL=C

CON_NAME="Hotspot"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hotspot"
PREV_WIFI_FILE="$CACHE_DIR/prev_wifi"

usage() {
    cat <<EOF
Sử dụng: $(basename "$0") <lệnh> [tham số]

Các lệnh khả dụng:
  on, start           Bật Mobile Hotspot
  off, stop           Tắt Mobile Hotspot
  toggle              Bật/Tắt Mobile Hotspot
  status              Xem trạng thái, thông tin & thiết bị kết nối
  clients             Xem danh sách thiết bị đang kết nối
  qr                  In mã QR và mật khẩu trong terminal
  qr-gui              Mở cửa sổ giao diện mã QR
  get-ssid            Hiển thị SSID hiện tại
  get-pass            Hiển thị Mật khẩu hiện tại
  set-ssid <tên>      Đổi tên trạm phát sóng Wi-Fi (SSID, tối đa 32 bytes)
  set-pass <pass>     Đổi mật khẩu Wi-Fi (8–63 ký tự ASCII hoặc 64 hex)
  set-band <bg|a>     Chọn băng tần: 'bg' (2.4 GHz) hoặc 'a' (5 GHz)
  help                Hiển thị trợ giúp này

EOF
}

cmd="${1:-status}"

# Check for help command early to bypass dependencies
if [[ "$cmd" == "help" || "$cmd" == "--help" || "$cmd" == "-h" ]]; then
    usage
    exit 0
fi

# Dependency check
for dep in nmcli ip iw flock; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        printf 'Lỗi: Không tìm thấy lệnh %s. Vui lòng cài đặt trước.\n' "$dep" >&2
        exit 1
    fi
done

# Ensure cache directory with secure permissions
install -d -m 700 "$CACHE_DIR"

# Find Wi-Fi interface (avoiding SIGPIPE on nmcli)
get_wifi_iface() {
    local ifaces iface
    if ! ifaces=$(nmcli -t --escape no -f DEVICE,TYPE device status 2>/dev/null); then
        printf 'Lỗi: Không thể truy vấn NetworkManager.\n' >&2
        exit 1
    fi
    iface=$(awk -F: '$2=="wifi"{print $1; exit}' <<< "$ifaces")
    if [[ -z "$iface" ]]; then
        printf 'Lỗi: Không tìm thấy card Wi-Fi nào trên hệ thống.\n' >&2
        exit 1
    fi
    printf '%s' "$iface"
}

WIFI_IFACE=$(get_wifi_iface)

# Check if interface supports AP mode
check_ap_support() {
    local iface_info wiphy phy_info

    iface_info=$(iw dev "$WIFI_IFACE" info 2>/dev/null) || {
        printf 'Lỗi: Không đọc được thông tin card %s.\n' "$WIFI_IFACE" >&2
        return 1
    }

    wiphy=$(awk '$1 == "wiphy" {print $2; exit}' <<< "$iface_info")
    [[ "$wiphy" =~ ^[0-9]+$ ]] || {
        printf 'Lỗi: Không xác định được PHY của %s.\n' "$WIFI_IFACE" >&2
        return 1
    }

    phy_info=$(iw phy "phy${wiphy}" info 2>/dev/null) || return 1

    if ! grep -Eq '^[[:space:]]+\*[[:space:]]+AP$' <<< "$phy_info"; then
        printf 'Lỗi: Card Wi-Fi %s không hỗ trợ AP mode.\n' "$WIFI_IFACE" >&2
        return 1
    fi
}

# Check if profile exists (no side effects)
profile_exists() {
    nmcli -g connection.id connection show "$CON_NAME" >/dev/null 2>&1
}

# Ensure Hotspot profile exists
ensure_profile() {
    if ! profile_exists; then
        check_ap_support

        # Generate random 16-char hex password (no pipeline to avoid SIGPIPE)
        local default_pass
        if command -v openssl >/dev/null 2>&1; then
            default_pass=$(openssl rand -hex 8)
        else
            default_pass=$(od -An -N8 -tx1 /dev/urandom | tr -d '[:space:]')
        fi

        if [[ ${#default_pass} -ne 16 ]]; then
            printf 'Lỗi: Không thể tạo mật khẩu ngẫu nhiên.\n' >&2
            return 1
        fi

        nmcli con add type wifi ifname "$WIFI_IFACE" con-name "$CON_NAME" autoconnect no \
            ssid "CachyOS-Hotspot" 802-11-wireless.mode ap 802-11-wireless.band bg \
            ipv4.method shared wifi-sec.key-mgmt wpa-psk \
            wifi-sec.psk "$default_pass" 802-11-wireless-security.pmf 1 \
            802-11-wireless.powersave 2
    else
        # Ensure PMF and powersave are correctly set for existing profiles
        local current_pmf current_ps
        current_pmf=$(nmcli -g 802-11-wireless-security.pmf connection show "$CON_NAME" 2>/dev/null || true)
        current_ps=$(nmcli -g 802-11-wireless.powersave connection show "$CON_NAME" 2>/dev/null || true)
        if [[ "$current_pmf" != 1* || "$current_ps" != 2* ]]; then
            nmcli con modify "$CON_NAME" 802-11-wireless-security.pmf 1 802-11-wireless.powersave 2
        fi
    fi
}

# Check if Hotspot is active (avoiding SIGPIPE on nmcli)
is_active() {
    local active_connections
    active_connections=$(nmcli -t --escape no -f NAME,DEVICE connection show --active 2>/dev/null) || return 1
    grep -Fxq -- "${CON_NAME}:${WIFI_IFACE}" <<< "$active_connections"
}

# Getters
get_ssid() {
    local ssid
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CON_NAME" 2>/dev/null) || {
        printf 'Lỗi: Không đọc được SSID.\n' >&2
        return 1
    }
    printf '%s\n' "$ssid"
}

get_pass() {
    local pass
    pass=$(nmcli -s -g 802-11-wireless-security.psk connection show "$CON_NAME" 2>/dev/null) || {
        printf 'Lỗi: Không đọc được mật khẩu. Có thể cần quyền truy cập.\n' >&2
        return 1
    }
    if [[ -z "$pass" ]]; then
        printf 'Lỗi: Mật khẩu trống hoặc không thể truy cập.\n' >&2
        return 1
    fi
    printf '%s\n' "$pass"
}

get_band() {
    local band
    band=$(nmcli -g 802-11-wireless.band connection show "$CON_NAME" 2>/dev/null || printf 'bg')
    if [[ "$band" == "a" ]]; then
        printf '5 GHz (802.11a/n/ac)\n'
    else
        printf '2.4 GHz (802.11b/g/n)\n'
    fi
}

get_ip() {
    if ! is_active; then
        printf 'N/A\n'
        return
    fi
    local addresses ip
    addresses=$(nmcli -g IP4.ADDRESS device show "$WIFI_IFACE" 2>/dev/null) || {
        printf 'N/A\n'
        return
    }
    ip=${addresses%%$'\n'*}
    ip=${ip%%/*}
    printf '%s\n' "${ip:-N/A}"
}

# Notification helper (never fails the script)
send_notify() {
    local summary="$1"
    local body="$2"
    local urgency="${3:-normal}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send \
            -a "Mobile Hotspot" \
            -u "$urgency" \
            -i "network-wireless-hotspot" \
            "$summary" "$body" 2>/dev/null || true
    fi
}

# Get connected clients count
get_clients_count() {
    if ! is_active; then
        printf '0\n'
        return
    fi
    local count
    count=$(iw dev "$WIFI_IFACE" station dump 2>/dev/null | grep -c "^Station" || true)
    printf '%s\n' "$count"
}

# List connected clients with details
list_clients() {
    if ! is_active; then
        printf 'Hotspot đang tắt.\n'
        return
    fi

    local stations
    if ! stations=$(iw dev "$WIFI_IFACE" station dump 2>/dev/null); then
        printf 'Lỗi: Không đọc được danh sách thiết bị kết nối.\n' >&2
        return 1
    fi
    
    if [[ -z "$stations" ]]; then
        printf 'Chưa có thiết bị nào kết nối.\n'
        return
    fi

    printf '=== DANH SÁCH THIẾT BỊ ĐANG KẾT NỐI ===\n\n'

    local cur_mac="" cur_sig="" cur_time="" count=0

    while IFS= read -r line; do
        if [[ "$line" =~ ^Station\ ([0-9a-fA-F:]{17}) ]]; then
            if [[ -n "$cur_mac" ]]; then
                print_client_info "$cur_mac" "$cur_sig" "$cur_time"
            fi
            cur_mac="${BASH_REMATCH[1]}"
            cur_sig="N/A"
            cur_time="N/A"
            count=$((count + 1))
        elif [[ "$line" =~ signal:[[:space:]]*(-?[0-9]+) ]]; then
            cur_sig="${BASH_REMATCH[1]} dBm"
        elif [[ "$line" =~ connected\ time:[[:space:]]*(.+)$ ]]; then
            cur_time="${BASH_REMATCH[1]}"
        fi
    done <<< "$stations"

    if [[ -n "$cur_mac" ]]; then
        print_client_info "$cur_mac" "$cur_sig" "$cur_time"
    fi

    if [[ "$count" -eq 0 ]]; then
        printf 'Chưa có thiết bị nào kết nối.\n'
    fi
}

print_client_info() {
    local mac="$1" sig="$2" ctime="$3" ip="" hostname=""

    ip=$(awk -v m="$mac" 'tolower($4) == tolower(m) {print $1; exit}' /proc/net/arp 2>/dev/null || true)
    if [[ -z "$ip" ]]; then
        ip=$(ip neigh show dev "$WIFI_IFACE" 2>/dev/null | awk -v m="$mac" 'tolower($5) == tolower(m) {print $1; exit}' || true)
    fi
    [[ -z "$ip" ]] && ip="Đang cấp phát..."

    if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        hostname=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' || true)
    fi

    printf '• MAC:      %s\n' "$mac"
    if [[ -n "$hostname" ]]; then
        printf '  IP:       %s (Tên: %s)\n' "$ip" "$hostname"
    else
        printf '  IP:       %s\n' "$ip"
    fi
    printf '  Tín hiệu: %s\n' "$sig"
    printf '  T.gian:   %s\n' "$ctime"
    printf '%s\n' "----------------------------------------"
}

# Acquire flock for state-changing commands only
acquire_lock() {
    exec 9>"$CACHE_DIR/lock"
    flock -n 9 || {
        printf 'Một lệnh hotspot khác đang chạy.\n' >&2
        exit 1
    }
}

get_active_wifi_uuid() {
    local rows uuid type device
    rows=$(nmcli -t --escape no -f UUID,TYPE,DEVICE connection show --active 2>/dev/null) || return 1
    while IFS=: read -r uuid type device; do
        if [[ "$type" == "802-11-wireless" && "$device" == "$WIFI_IFACE" ]]; then
            printf '%s\n' "$uuid"
            return 0
        fi
    done <<< "$rows"
    return 1
}

# Start Hotspot
start_hotspot() {
    # Ensure Wi-Fi radio is enabled and unblocked
    if [[ "$(nmcli -g WIFI radio 2>/dev/null || true)" != "enabled" ]]; then
        printf 'Đang mở Wi-Fi radio...\n'
        nmcli radio wifi on >/dev/null 2>&1 || true
        command -v rfkill >/dev/null 2>&1 && rfkill unblock wifi >/dev/null 2>&1 || true
        sleep 1
    fi

    ensure_profile

    if is_active; then
        local ssid
        ssid=$(get_ssid)
        send_notify "Hotspot đang hoạt động" "Tên mạng: $ssid"
        printf 'Hotspot đang hoạt động: %s\n' "$ssid"
        return 0
    fi

    # Save currently connected Wi-Fi UUID (if any)
    local active_uuid hotspot_uuid
    active_uuid=$(get_active_wifi_uuid || true)
    hotspot_uuid=$(nmcli -g connection.uuid connection show "$CON_NAME" 2>/dev/null || true)

    if [[ -n "$active_uuid" && "$active_uuid" != "$hotspot_uuid" ]]; then
        printf '%s\n' "$active_uuid" > "$PREV_WIFI_FILE"
    elif [[ -z "$active_uuid" && -s "$PREV_WIFI_FILE" ]]; then
        # A previous activation/recovery may have failed. Retry its recovery
        # without losing the saved UUID just because Wi-Fi is disconnected.
        active_uuid=$(cat "$PREV_WIFI_FILE")
    else
        rm -f "$PREV_WIFI_FILE"
    fi

    printf 'Đang khởi động Mobile Hotspot trên interface %s...\n' "$WIFI_IFACE"
    local nm_err
    if nm_err=$(nmcli con up id "$CON_NAME" ifname "$WIFI_IFACE" 2>&1); then
        local ssid body
        ssid=$(get_ssid)
        printf -v body "SSID: %s\nDùng lệnh 'hotspot qr' để xem mật khẩu" "$ssid"
        send_notify "Mobile Hotspot đã bật 🟢" "$body"
        printf 'Hotspot đã bật thành công!\n'
        printf 'SSID: %s\n' "$ssid"
        printf 'IP: %s\n' "$(get_ip)"
    else
        send_notify "Lỗi kích hoạt Hotspot" "Không thể khởi động kết nối '$CON_NAME'!" "critical"
        printf 'Lỗi: Không thể bật Hotspot.\n' >&2
        [[ -n "$nm_err" ]] && printf 'Chi tiết lỗi: %s\n' "$nm_err" >&2
        # Activation may already have disconnected the original Wi-Fi.
        # Keep its UUID if recovery fails, so it is not silently lost.
        if [[ -n "$active_uuid" && "$active_uuid" != "$hotspot_uuid" ]]; then
            printf 'Đang khôi phục mạng Wi-Fi trước đó...\n' >&2
            if nmcli -w 30 con up uuid "$active_uuid" >/dev/null 2>&1; then
                rm -f "$PREV_WIFI_FILE"
            else
                printf 'Lỗi: Không thể khôi phục Wi-Fi trước đó; UUID vẫn được lưu tại %s.\n' "$PREV_WIFI_FILE" >&2
            fi
        fi
        return 1
    fi
}

# Stop Hotspot
stop_hotspot() {
    if ! is_active; then
        printf 'Hotspot hiện không hoạt động.\n'
        return 0
    fi

    printf 'Đang tắt Mobile Hotspot...\n'
    if nmcli con down "$CON_NAME" >/dev/null 2>&1; then
        send_notify "Mobile Hotspot đã tắt 🔴" "Đã ngắt trạm phát sóng Wi-Fi"
        printf 'Hotspot đã tắt.\n'
    else
        printf 'Lỗi: Không thể tắt Hotspot.\n' >&2
        return 1
    fi

    # Reconnect to previous Wi-Fi if saved (close fd 9 so lock is released)
    if [[ -f "$PREV_WIFI_FILE" ]]; then
        local prev_wifi
        prev_wifi=$(cat "$PREV_WIFI_FILE")
        if [[ -n "$prev_wifi" ]]; then
            printf 'Đang kết nối lại mạng Wi-Fi trước đó...\n'
            if nmcli con up uuid "$prev_wifi" >/dev/null 2>&1 9>&-; then
                rm -f "$PREV_WIFI_FILE"
                send_notify "Wi-Fi đã kết nối lại 🟢" "Đã khôi phục kết nối Wi-Fi trước đó"
            else
                send_notify "Lỗi kết nối Wi-Fi ⚠️" "Không thể kết nối lại mạng trước đó. Giữ file cấu hình để thử lại." "critical"
                printf 'Cảnh báo: Không thể kết nối lại Wi-Fi trước đó (UUID: %s). File lưu trạng thái được giữ lại.\n' "$prev_wifi" >&2
            fi
        else
            rm -f "$PREV_WIFI_FILE"
        fi
    fi
}

# QR escaping
qr_escape() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//;/\\;}
    value=${value//,/\\,}
    value=${value//:/\\:}
    printf '%s' "$value"
}

get_qr_string() {
    local ssid pass
    ssid=$(get_ssid) || return 1
    pass=$(get_pass) || return 1
    printf 'WIFI:T:WPA;S:%s;P:%s;;\n' \
        "$(qr_escape "$ssid")" \
        "$(qr_escape "$pass")"
}

# Show QR in terminal
show_qr() {
    ensure_profile
    local ssid pass qr_str
    ssid=$(get_ssid)
    pass=$(get_pass)
    qr_str=$(get_qr_string)

    printf '==========================================\n'
    printf '  MÃ QR KẾT NỐI MOBILE HOTSPOT\n'
    printf '==========================================\n'
    printf '  SSID:     %s\n' "$ssid"
    printf '  Mật khẩu: %s\n' "$pass"
    printf '==========================================\n\n'

    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t UTF8 "$qr_str"
    else
        printf '(Chưa cài đặt qrencode để hiển thị mã QR)\n'
    fi
    printf '\nQuét mã QR bằng camera điện thoại để kết nối tự động.\n'
}

qr_popup() {
    clear 2>/dev/null || true
    show_qr
    printf '\nNhấn phím [Enter] hoặc [q] để đóng cửa sổ này...\n'
    read -r -n 1 -s key || true
}

open_qr_window() {
    if command -v kitty >/dev/null 2>&1; then
        kitty --class hotspot-qr --title "Mobile Hotspot - Mã QR" -e "$0" qr-popup &
    elif command -v alacritty >/dev/null 2>&1; then
        alacritty --class hotspot-qr --title "Mobile Hotspot - Mã QR" -e "$0" qr-popup &
    else
        "$0" qr
    fi
}

# Config Setters
set_ssid() {
    local new_ssid="$1"
    if [[ -z "$new_ssid" ]]; then
        printf 'Lỗi: Tên mạng SSID không được để trống.\n' >&2
        return 1
    fi

    if [[ "$new_ssid" == *$'\n'* || "$new_ssid" == *$'\r'* ]]; then
        printf 'Lỗi: SSID không được chứa ký tự xuống dòng.\n' >&2
        return 1
    fi

    # SSID tối đa 32 bytes
    if [[ $(printf '%s' "$new_ssid" | wc -c) -gt 32 ]]; then
        printf 'Lỗi: Tên mạng SSID không được vượt quá 32 bytes.\n' >&2
        return 1
    fi

    ensure_profile
    nmcli con modify "$CON_NAME" 802-11-wireless.ssid "$new_ssid"
    send_notify "Đã đổi tên Hotspot" "Tên mới: $new_ssid"
    printf 'Đã cập nhật SSID thành: %s\n' "$new_ssid"
    if is_active; then
        printf 'Đang áp dụng thay đổi...\n'
        nmcli con up id "$CON_NAME" ifname "$WIFI_IFACE" >/dev/null 2>&1
    fi
}

set_pass() {
    local new_pass="$1"

    if [[ "$new_pass" =~ ^[0-9A-Fa-f]{64}$ ]]; then
        : # Hợp lệ (Hex 64 ký tự)
    elif [[ "$new_pass" =~ ^[[:print:]]{8,63}$ ]]; then
        : # Hợp lệ (ASCII 8-63 ký tự)
    else
        printf 'Lỗi: Mật khẩu phải gồm 8–63 ký tự ASCII hoặc đúng 64 ký tự hex.\n' >&2
        send_notify "Lỗi đổi mật khẩu" "Mật khẩu không hợp lệ!" "critical"
        return 1
    fi

    ensure_profile
    nmcli con modify "$CON_NAME" 802-11-wireless-security.psk "$new_pass"
    send_notify "Đã đổi mật khẩu Hotspot" "Mật khẩu mới đã được cập nhật."
    printf 'Đã cập nhật mật khẩu thành công!\n'
    if is_active; then
        printf 'Đang áp dụng thay đổi...\n'
        nmcli con up id "$CON_NAME" ifname "$WIFI_IFACE" >/dev/null 2>&1
    fi
}

set_band() {
    local new_band="$1"
    if [[ "$new_band" != "bg" && "$new_band" != "a" ]]; then
        printf "Lỗi: Băng tần chỉ hỗ trợ 'bg' (2.4 GHz) hoặc 'a' (5 GHz).\n" >&2
        return 1
    fi
    ensure_profile
    local desc
    if [[ "$new_band" == "a" ]]; then
        nmcli con modify "$CON_NAME" 802-11-wireless.band "a" 802-11-wireless.channel "0"
        desc="5 GHz"
    else
        nmcli con modify "$CON_NAME" 802-11-wireless.band "bg" 802-11-wireless.channel "0"
        desc="2.4 GHz"
    fi
    send_notify "Đã đổi băng tần" "Băng tần hiện tại: $desc"
    printf 'Đã chuyển băng tần sang: %s\n' "$desc"
    if is_active; then
        printf 'Đang áp dụng thay đổi...\n'
        nmcli con up id "$CON_NAME" ifname "$WIFI_IFACE" >/dev/null 2>&1
    fi
}

# Show detailed status (Password hidden)
show_status() {
    if ! profile_exists; then
        printf 'Chưa có cấu hình Hotspot. Dùng "hotspot on" để tạo và bật.\n'
        return 0
    fi

    local active_str="TẮT 🔴"
    if is_active; then
        active_str="ĐANG BẬT 🟢"
    fi

    printf '==========================================\n'
    printf '        THÔNG TIN MOBILE HOTSPOT\n'
    printf '==========================================\n'
    printf 'Trạng thái:        %s\n' "$active_str"
    printf 'Tên mạng (SSID):   %s\n' "$(get_ssid)"
    printf 'Mật khẩu (Pass):   (Đã ẩn - dùng "hotspot qr" hoặc "hotspot get-pass" để xem)\n'
    printf 'Băng tần:          %s\n' "$(get_band)"
    printf 'Card mạng:         %s\n' "$WIFI_IFACE"
    printf 'Địa chỉ IP:        %s\n' "$(get_ip)"
    printf 'Số thiết bị nối:   %s thiết bị\n' "$(get_clients_count)"
    printf '==========================================\n'
    if is_active; then
        printf '\n'
        list_clients
    fi
}

case "$cmd" in
    on|start|off|stop|toggle|set-ssid|set-pass|set-band)
        acquire_lock
        ;;
esac

case "$cmd" in
    on|start) start_hotspot ;;
    off|stop) stop_hotspot ;;
    toggle)
        if is_active; then
            stop_hotspot
        else
            start_hotspot
        fi
        ;;
    status) show_status ;;
    clients) list_clients ;;
    qr) show_qr ;;
    qr-popup) qr_popup ;;
    qr-gui) open_qr_window ;;
    get-ssid)
        if ! profile_exists; then printf 'Chưa có cấu hình Hotspot.\n' >&2; exit 1; fi
        get_ssid
        ;;
    get-pass)
        if ! profile_exists; then printf 'Chưa có cấu hình Hotspot.\n' >&2; exit 1; fi
        get_pass
        ;;
    set-ssid)
        [[ $# -lt 2 ]] && { printf 'Lỗi: Cần cung cấp tên SSID mới.\n' >&2; exit 1; }
        set_ssid "$2"
        ;;
    set-pass)
        [[ $# -lt 2 ]] && { printf 'Lỗi: Cần cung cấp mật khẩu mới.\n' >&2; exit 1; }
        set_pass "$2"
        ;;
    set-band)
        [[ $# -lt 2 ]] && { printf 'Lỗi: Cần chỉ định bg hoặc a.\n' >&2; exit 1; }
        set_band "$2"
        ;;
    *)
        printf 'Lệnh không hợp lệ: %s\n' "$cmd" >&2
        usage
        exit 1
        ;;
esac
