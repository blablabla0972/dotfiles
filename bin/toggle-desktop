#!/usr/bin/env bash
# toggle-desktop — Hyprland "Show Desktop" (hide all windows, reveal the wallpaper).
#
# Hyprland is a tiling compositor and has no per-window minimise button, so this
# emulates the Windows "Show Desktop" strip: pressing it jumps to a dedicated
# EMPTY workspace (default 10) so you see only the desktop, and pressing again
# returns you to the workspace you came from.
set -euo pipefail

# Ensure only one instance runs at a time to serialize intentional calls
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/toggle-desktop.lock"
mkdir -p "${LOCKFILE%/*}" 2>/dev/null || true
exec 200>"$LOCKFILE"
flock 200

DESKTOP_WS="${HYPR_DESKTOP_WS:-10}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/toggle-desktop.state"

mon_info="$(hyprctl monitors -j 2>/dev/null || echo '[]')"

# Validate and extract in one jq process; NUL framing preserves workspace names.
mapfile -d '' -t vals < <(jq -e -j 'map(select(.focused == true)) |
    if length == 1 then .[0] |
        [(.activeWorkspace.name // "1"), (.specialWorkspace.id // 0), (.specialWorkspace.name // "")] |
        .[] | tostring + "\u0000"
    else error("Expected exactly 1 focused monitor") end' <<< "$mon_info")
monitor_parser_pid=$!
wait "$monitor_parser_pid" || exit 1
cur_ws="${vals[0]:-1}"
special_id="${vals[1]:-0}"
special_name="${vals[2]:-}"

# Quote Lua strings, including semicolons consumed by hyprctl's batch parser.
lua_string() {
    if [[ "$1" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
        printf '"%s"' "$1"
        return
    fi
    jq -nr --arg value "$1" '$value | explode | map(
        if . < 32 or . == 34 or . == 59 or . == 92 or . == 127 then
            "\\" + ((. + 1000) | tostring | .[1:])
        else [.] | implode end
    ) | join("") | "\"" + . + "\""'
}

toggle_special() {
    local name="$1"
    if [[ "$name" == "special" || -z "$name" ]]; then
        printf 'dispatch hl.dsp.workspace.toggle_special()'
    else
        printf 'dispatch hl.dsp.workspace.toggle_special(%s)' "$(lua_string "${name#special:}")"
    fi
}

# Helper function to execute batch and validate
dispatch_and_validate() {
    local batch_cmds="$1"
    local batch_out
    # hyprctl dispatch can return 0 but output "error:" with the lua bridge
    if ! batch_out=$(hyprctl --batch "$batch_cmds" 2>&1) || [[ "${batch_out,,}" == *error* ]]; then
        echo "Dispatch error: $batch_out" >&2
        return 1
    fi
    return 0
}

# Nếu special workspace (cửa sổ thu nhỏ / đặc biệt) đang mở che màn hình, đóng nó lại
if [ "$special_id" != "0" ] && [ "$special_name" != "null" ]; then
    batch_cmds="$(toggle_special "$special_name")"
    if [ "$cur_ws" != "$DESKTOP_WS" ]; then
        batch_cmds="$batch_cmds ; dispatch hl.dsp.focus({ workspace = $(lua_string "$DESKTOP_WS") })"
    fi
    
    dispatch_and_validate "$batch_cmds" || exit 1
    printf '%s\0special:%s\0' "$cur_ws" "$special_name" > "$STATE"
    exit 0
fi

# Nếu đang ở workspace màn hình trống (10) -> quay trở lại workspace cũ
if [ "$cur_ws" = "$DESKTOP_WS" ]; then
    target_ws="previous"
    restore_special=""
    state_content=""
    if [ -f "$STATE" ]; then
        mapfile -d '' -t saved < "$STATE"
        saved_ws="${saved[0]:-}"
        saved_special="${saved[1]:-}"
        if [ "${#saved[@]}" -lt 2 ]; then
            # Restore an in-flight toggle written by the previous script version.
            state_content="$saved_ws"
            saved_ws="${state_content%%|*}"
            saved_special="${state_content#*|}"
            [ "$saved_special" != "$state_content" ] || saved_special=""
        fi
        if [ -n "$saved_ws" ] && [ "$saved_ws" != "$DESKTOP_WS" ]; then
            target_ws="$saved_ws"
        fi
        if [ -n "$saved_special" ]; then
            restore_special="1"
        fi
    fi
    
    batch_cmds="dispatch hl.dsp.focus({ workspace = $(lua_string "$target_ws") })"
    if [ -n "$restore_special" ]; then
        batch_cmds="$batch_cmds ; $(toggle_special "${saved_special#special:}")"
    fi
    
    dispatch_and_validate "$batch_cmds" || exit 1
    rm -f "$STATE"
else
    # Đang ở workspace bình thường -> lưu lại workspace hiện tại và nhảy về workspace 10 (màn hình không có cửa sổ)
    dispatch_and_validate "dispatch hl.dsp.focus({ workspace = $(lua_string "$DESKTOP_WS") })" || exit 1
    printf '%s\0\0' "$cur_ws" > "$STATE"
fi
