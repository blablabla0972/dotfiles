{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos_small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰅂 "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS   ", "keyColor": "green" },
    { "type": "kernel", "key": "Kernel", "keyColor": "green" },
    { "type": "uptime", "key": "Uptime", "keyColor": "green" },
    { "type": "wm", "key": "WM    ", "keyColor": "cyan" },
    { "type": "terminal", "key": "Term  ", "keyColor": "cyan" },
    { "type": "shell", "key": "Shell ", "keyColor": "cyan" },
    { "type": "cpu", "key": "CPU   ", "keyColor": "yellow", "format": "{1}" },
    { "type": "gpu", "key": "GPU   ", "keyColor": "yellow", "format": "{name}" },
    { "type": "memory", "key": "Memory", "keyColor": "yellow" },
    "break",
    "colors"
  ]
}
