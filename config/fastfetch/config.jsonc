{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "CachyOS_small",
    "color": {
      "1": "blue",
      "2": "cyan",
      "3": "magenta"
    },
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "bar": {
      "width": 6,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": null
    },
    "percent": {
      "type": 3
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#blue}C A C H Y O S{#}  {#cyan}// WORKSTATION{#}"
    },
    {
      "type": "title",
      "format": "{#cyan}{user-name}{#}@{host-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#blue}── 󰍹  SYSTEM ──────────────{#}"
    },
    {
      "type": "os",
      "key": "  Distro   ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  Kernel   ",
      "keyColor": "blue",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "󰖯  Desktop  ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "  Shell    ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  Terminal ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "󰅐  Uptime   ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{#blue}──────────────────────────────{#}"
    },
    {
      "type": "custom",
      "format": "{#magenta}── 󰍛  RESOURCES ──────────────{#}"
    },
    {
      "type": "cpu",
      "key": "󰍛  CPU      ",
      "keyColor": "magenta",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  RAM      ",
      "keyColor": "magenta",
      "format": "{percentage-bar} {used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk     ",
      "keyColor": "magenta",
      "format": "{size-percentage-bar} {size-used} / {size-total}",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "󰁹  Battery  ",
      "keyColor": "magenta",
      "format": "{capacity-bar} {capacity} {status}"
    },
    {
      "type": "custom",
      "format": "{#magenta}──────────────────────────────{#}"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}
