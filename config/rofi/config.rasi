@theme "/dev/null"
@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    display-drun: "Applications";
    display-window: "Windows";
    display-run: "Run";
    drun-display-format: "{icon} {name}";
    font: "Adwaita Sans 11";
    show-icons: true;
    icon-theme: "Papirus";
}

window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       calc(70% min 900px);
    height:                      calc(75% min 680px);
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    border:                      1px solid;
    border-color:                @outline-variant;
    border-radius:               16px;
    cursor:                      "default";
    background-color:            @surface;
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

imagebox {
    border-radius:               16px 0px 0px 16px;
    width:                       calc(21% min 270px);
    expand:                      false;
    padding:                     20px;
    background-color:            transparent;
    background-image:            url("~/.config/rofi/wallpaper_thumb.jpg", height);
    orientation:                 vertical;
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    expand:                      true;
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

dummy {
    background-color:            transparent;
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    font:                        "JetBrainsMono Nerd Font 11";
    enabled:                     true;
    expand:                      false;
    str:                         "  ";
    background-color:            inherit;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

mode-switcher {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @on-surface;
}

button {
    padding:                     15px;
    border-radius:               10px;
    background-color:            @surface-container-high;
    text-color:                  inherit;
    cursor:                      pointer;
}

button selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     10px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element normal.urgent {
    background-color:            @error;
    text-color:                  @on-error;
}

element normal.active {
    background-color:            @primary-container;
    text-color:                  @on-primary-container;
}

element selected.normal {
    background-color:            @primary;
    text-color:                  @on-primary;
}

element selected.urgent {
    background-color:            @error;
    text-color:                  @on-error;
}

element selected.active {
    background-color:            @primary;
    text-color:                  @on-primary;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

message {
    background-color:            transparent;
}

textbox {
    padding:                     15px;
    border-radius:               10px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     15px;
    border-radius:               20px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
}
