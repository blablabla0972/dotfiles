default partial modifier_keys
xkb_symbols "caps_nav" {
    replace key <CAPS> {
        type[Group1] = "ONE_LEVEL",
        symbols[Group1] = [ ISO_Level3_Shift ]
    };
    modifier_map Mod5 { <CAPS> };

    replace key <AC06> { type[Group1] = "FOUR_LEVEL", [ h, H, Left, Left ] };
    replace key <AC07> { type[Group1] = "FOUR_LEVEL", [ j, J, Down, Down ] };
    replace key <AC08> { type[Group1] = "FOUR_LEVEL", [ k, K, Up, Up ] };
    replace key <AC09> { type[Group1] = "FOUR_LEVEL", [ l, L, Right, Right ] };
};
