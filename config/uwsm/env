export PATH="$HOME/.local/bin:$PATH"
export BROWSER=brave-origin
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Input method (Fcitx5)
# Do NOT set GTK_IM_MODULE on Wayland to avoid key swallowing in GTK/Chromium apps
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# Cursors
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# If you have an NVIDIA GPU uncomment the following lines:
# export GBM_BACKEND=nvidia-drm
# export __GLX_VENDOR_LIBRARY_NAME=nvidia
# export LIBVA_DRIVER_NAME=nvidia
# export __GL_GSYNC_ALLOWED=1
